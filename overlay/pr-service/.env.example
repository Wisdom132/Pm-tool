# ── GitHub App ───────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/apps → New GitHub App
#
# Callback URL:        http://localhost:3001/api/auth/extension-callback
# Request user authorization (OAuth) during installation:  enabled
# Webhooks:            disabled
#
# Repository permissions:
#   Contents      Read and write   (create branches, commit files)
#   Pull requests Read and write   (open pull requests)
#   Metadata      Read-only        (implied)
#
# Writes are performed with an installation token, so an editor who only has
# read access to the repository can still open a pull request.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The app's private key (.pem). Accepts a raw PEM, a PEM with literal \n
# sequences, or the whole file base64-encoded — whichever your host allows.
GITHUB_APP_PRIVATE_KEY=

# ── Service base URL ──────────────────────────────────────────────────────────
# Must match the callback URL registered on the GitHub App.
APP_URL=http://localhost:3001

# ── Session encryption ────────────────────────────────────────────────────────
# Encrypts the GitHub tokens held in the session store. Rotating this
# invalidates every existing session.
# Run: openssl rand -base64 32
TOKEN_SECRET=

# ── Allowed browser extensions ────────────────────────────────────────────────
# Comma-separated Chrome extension IDs. Gates both the OAuth redirect target
# and the CORS allowlist. REQUIRED in production; when unset outside
# production, any extension is accepted so first-run setup is possible.
# Find the ID at chrome://extensions with Developer mode on.
ALLOWED_EXTENSION_IDS=

# ── Session store (optional) ──────────────────────────────────────────────────
# Without these, sessions are held in process memory: fine for local
# development, but they will not survive a restart or be shared between
# serverless instances. Required for any real deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Anthropic (AI source-file disambiguation) ─────────────────────────────────
# Get at: https://console.anthropic.com/settings/keys
# Used only when multiple files contain the same edited text
ANTHROPIC_API_KEY=

# ── Logging (optional) ────────────────────────────────────────────────────────
# debug | info | warn | error   (default: info)
LOG_LEVEL=
