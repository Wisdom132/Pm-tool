{
  "name": "@quartalyst/inline-edit-annotation",
  "version": "1.0.0",
  "description": "Build-time annotation plugins for the Inline Edit Tool — stamp source locations onto the DOM so rendered text can be traced back to the file it came from (React, Vue, Svelte, Angular)",
  "license": "MIT",
  "keywords": [
    "inline-edit",
    "babel-plugin",
    "vite-plugin",
    "webpack-loader",
    "source-map",
    "cms",
    "preview-deploy"
  ],
  "main": "react/index.js",
  "exports": {
    "./react": "./react/index.js",
    "./vue": "./vue/index.js",
    "./svelte": "./svelte/index.js",
    "./angular": "./angular/index.js",
    "./angular/webpack-config": "./angular/webpack.config.js",
    "./angular/loader": "./angular/template-loader.js",
    "./build-info": "./lib/build-info.js"
  },
  "files": [
    "react",
    "vue",
    "svelte",
    "angular",
    "lib",
    "README.md"
  ],
  "peerDependencies": {
    "@babel/core": ">=7",
    "@vue/compiler-sfc": ">=3",
    "@vue/compiler-dom": ">=3"
  },
  "peerDependenciesMeta": {
    "@babel/core": { "optional": true },
    "@vue/compiler-sfc": { "optional": true },
    "@vue/compiler-dom": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
