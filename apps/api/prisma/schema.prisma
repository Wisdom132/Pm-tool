// ============================================================
//  Tenants, sites and provider connections
//
//  Every model except Organisation carries organisationId, and
//  every query is expected to filter on it. Getting that wrong
//  once shows one customer another customer's source code, so
//  it is a column on the row rather than a join away.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Tenants ------------------------------------------------

model Organisation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  /// Set rather than deleted. A deletion has to reach several stores,
  /// and a row that is gone cannot be used to find what is left.
  deletedAt DateTime? @map("deleted_at")

  memberships  Memberships[]
  invitations  Invitation[]
  connections  Connection[]
  sites        Site[]
  environments SiteEnvironment[]
  teams        Team[]
  auditEvents  AuditEvent[]
  feedback     Feedback[]

  @@map("organisation")
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  /// Identity is an email, not a GitHub account: the editors this is for
  /// are writers and product managers who may have neither.
  email      String    @unique
  name       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")

  memberships        Memberships[]
  teamMemberships    TeamMember[]
  sessions           Session[]
  createdConnections Connection[]  @relation("ConnectionCreatedBy")
  auditEvents        AuditEvent[]
  authoredFeedback   Feedback[]    @relation("FeedbackAuthor")
  resolvedFeedback   Feedback[]    @relation("FeedbackResolver")

  @@map("app_user")
}

enum Role {
  /// Connects providers, registers sites, invites people.
  admin

  /// Opens pull requests and leaves feedback. Deliberately cannot
  /// re-point a site at a different repository.
  editor
}

/// A person can belong to more than one organisation: agencies edit
/// several clients' sites, and a contractor is in the same position.
model Memberships {
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organisationId, userId])
  @@map("membership")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  email          String
  role           Role
  /// The token itself is emailed and never stored; this is its hash, so a
  /// leaked database does not hand out memberships.
  tokenHash      String    @unique @map("token_hash")
  /// Which teams they join on accepting. Empty means the default team only.
  teamIds        String[]  @map("team_ids") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("invitation")
}

// ---- Provider connections -----------------------------------

enum Provider {
  github
  gitlab
  bitbucket
}

/// One per organisation per provider account. Holds credentials for
/// somebody else's repositories, which is why nothing here is stored in
/// the clear and why every use is written to AuditEvent.
model Connection {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  provider       Provider

  /// The org / group / workspace on the provider's side, for display.
  accountLogin String  @map("account_login")
  /// GitHub App installation id, GitLab group id, and so on.
  externalId   String  @map("external_id")
  /// Set for self-hosted GitLab and GitHub Enterprise; null for the public
  /// host. Designed in now because retrofitting it is painful.
  baseUrl      String? @map("base_url")

  /// Ciphertext. The application encrypts before writing.
  credentials Bytes?
  /// Which key encrypted it, so keys rotate without one migration having
  /// to decrypt everything at once.
  keyVersion  Int    @default(1) @map("key_version")

  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("ConnectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  environments SiteEnvironment[]

  @@unique([organisationId, provider, externalId])
  @@map("connection")
}

// ---- Sites --------------------------------------------------

/// What the extension asks about: "this page is on staging.acme.com —
/// which repository and branch am I editing?"
model Site {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid
  name           String

  /// Ownership is verified before a site goes live. Without it anyone
  /// could claim a hostname and collect feedback meant for its owner.
  verifiedAt        DateTime? @map("verified_at")
  verificationToken String    @map("verification_token")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  environments SiteEnvironment[]
  teams        TeamSite[]
  feedback     Feedback[]

  @@index([organisationId])
  @@map("site")
}

/// A site has several of these — production, staging, and a wildcard for
/// preview deploys. Separate rows because each points at its own branch.
model SiteEnvironment {
  id             String @id @default(uuid()) @db.Uuid
  siteId         String @map("site_id") @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid
  connectionId   String @map("connection_id") @db.Uuid

  /// "acme.com", "staging.acme.com", "*.acme.vercel.app".
  /// One wildcard label, at the front.
  hostname   String
  /// production / staging / preview — a label, not behaviour.
  label      String
  /// "owner/name"
  repository String

  /// Null means "take it from the page", which is what preview deploys
  /// need: the branch is in the URL or stamped on the build, and differs
  /// per deployment.
  branch String?

  createdAt DateTime @default(now()) @map("created_at")

  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// Restrict, not cascade: disconnecting a provider that sites still
  /// depend on should fail loudly rather than silently orphan them.
  connection   Connection   @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  feedback Feedback[]

  @@unique([organisationId, hostname])
  @@index([hostname])
  @@map("site_environment")
}

// ---- Sign-in ------------------------------------------------

/// A magic link, in flight.
///
/// Only the hash is stored. A leaked database should not hand out working
/// sign-in links, and the plaintext has already been emailed by then.
model LoginToken {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  /// Set the moment it is used. A link that works twice is a link that can be
  /// replayed out of a forwarded email.
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("login_token")
}

/// A signed-in session, server side.
///
/// Stateful rather than a bare JWT so that "revoke" and "sign out everywhere"
/// actually end the session, instead of politely asking a token to expire.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  /// dashboard — an httpOnly cookie in a browser.
  /// extension — a bearer token held by the browser extension.
  kind       String    @default("dashboard")
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// ---- Teams --------------------------------------------------

/// A named group of people with access to a set of sites.
///
/// The organisation role says what someone may *do* — an editor opens pull
/// requests, an admin also connects providers. A team says what they may do
/// it *to*. An agency's designers should not be able to edit the client site
/// they are not working on, and role alone cannot express that.
///
/// Every organisation gets an "Everyone" team covering all its sites. Without
/// a default, inviting someone would appear to work and then show them an
/// empty dashboard, which reads as a broken invitation rather than as missing
/// permissions.
model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  /// The organisation's default. Cannot be deleted, and new members join it.
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  sites        TeamSite[]

  @@unique([organisationId, name])
  @@map("team")
}

model TeamMember {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_member")
}

/// Which sites a team can edit.
model TeamSite {
  teamId String @map("team_id") @db.Uuid
  siteId String @map("site_id") @db.Uuid

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([teamId, siteId])
  @@map("team_site")
}

// ---- Audit --------------------------------------------------

/// Cheap to write now, very expensive to reconstruct later.
model AuditEvent {
  id             BigInt   @id @default(autoincrement())
  organisationId String   @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  /// connection.created, site.registered, branch.changed, pr.opened…
  action         String
  subject        String?
  detail         Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt(sort: Desc)])
  @@map("audit_event")
}

enum FeedbackStatus {
  new
  triaged
  resolved
}

/// A comment left on a page by someone who will never open the repository.
///
/// Distinct from an issue or a pull request: the author may not have an
/// account at all. What makes it worth more than a general feedback tool is
/// `sourceFile` — where the page is annotated, the comment is pinned to the
/// line that produced the element, which is the same link the editor uses.
model Feedback {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @map("organisation_id") @db.Uuid
  siteId         String  @map("site_id") @db.Uuid
  /// Which environment it came from, when the hostname resolved to one.
  environmentId  String? @map("environment_id") @db.Uuid

  message  String
  /// Full URL as seen, and the path alone for grouping.
  pageUrl  String @map("page_url")
  pagePath String @map("page_path")

  /// A CSS selector for the element, for re-finding it on the page.
  element    String?
  /// Set when the page carried a build annotation. The differentiator.
  sourceFile String? @map("source_file")
  sourceLine Int?    @map("source_line")

  /// Free text: a public widget has no account to attribute to. Null for
  /// an anonymous submission.
  authorName   String? @map("author_name")
  authorEmail  String? @map("author_email")
  /// Set only when the author was signed in — the extension path.
  authorUserId String? @map("author_user_id") @db.Uuid

  /// Context nobody types. P3.3.
  viewport  String?
  userAgent String? @map("user_agent")

  status       FeedbackStatus @default(new)
  resolvedById String?        @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?      @map("resolved_at")
  /// Set once promoted into an issue or change request.
  promotedUrl  String?        @map("promoted_url")

  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  environment  SiteEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  authorUser   User?            @relation("FeedbackAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?            @relation("FeedbackResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([organisationId, status, createdAt(sort: Desc)])
  @@index([siteId])
  @@map("feedback")
}
