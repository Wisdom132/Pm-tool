# Postgres. Neon and Supabase both hand you a URL in this shape.
DATABASE_URL="postgresql://user:password@host:5432/inline_edit?sslmode=require"

PORT=3333
# Comma separated. The dashboard, plus any site the extension runs on.
CORS_ORIGINS="http://localhost:4200"

# AES-256-GCM key for provider credentials at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Comma-separate to rotate: the first key encrypts new writes, the rest only
# decrypt, so an old key can be retired once nothing references it.
CREDENTIALS_KEY=

# GitHub App, from its settings page. The private key may be pasted raw, with
# literal \n sequences, or base64-encoded.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

DASHBOARD_URL=http://localhost:4200
